<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/akn_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar: back, position, text size, chords -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/text_position"
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/button_smaller"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/detail_smaller"
            android:text="A&#x2212;" />

        <TextView
            android:id="@+id/button_larger"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/detail_larger"
            android:text="A+" />

        <TextView
            android:id="@+id/button_chords"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/detail_toggle_chords"
            android:text="&#x266F;" />

        <TextView
            android:id="@+id/button_queue"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/queue_button" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/akn_divider" />

    <ScrollView
        android:id="@+id/scroll_song"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/content_song"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="56dp">

            <TextView
                android:id="@+id/text_song_title"
                style="@style/Text.DetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_song_artist"
                style="@style/Text.DetailArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- The song's own "chords" field, shown as written -->
            <TextView
                android:id="@+id/text_chords_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:fontFamily="monospace"
                android:textColor="@color/akn_accent"
                android:visibility="gone" />

            <!-- Chord/lyric chart, built by ChordChartRenderer -->
            <TextView
                android:id="@+id/text_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/akn_text_primary" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/akn_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/button_prev"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/detail_prev" />

        <TextView
            android:id="@+id/button_next"
            style="@style/Widget.Akn.ToolButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/detail_next" />
    </LinearLayout>
</LinearLayout>
